# ==========================================================
# 55 smartCREATIVES — Environment Configuration (.env)
# ==========================================================

# ----------------------------------------------------------
# 1. DATABASE CONFIGURATION (Persistent Cloud MySQL)
# ----------------------------------------------------------
# Recommended: Set DATABASE_URL in Vercel Project Settings -> Environment Variables.
# Compatible with Railway, PlanetScale, TiDB Serverless, Aiven, or any MySQL host.
#
# Examples:
# Railway:       DATABASE_URL=mysql://root:password@roundhouse.proxy.rlwy.net:12345/railway
# TiDB Cloud:    DATABASE_URL=mysql://user.root:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/art_gallery_db?ssl={"rejectUnauthorized":true}
# PlanetScale:   DATABASE_URL=mysql://user:pscale_pw@aws.connect.psdb.cloud/art_gallery_db?sslAccept=strict
# Aiven MySQL:   DATABASE_URL=mysql://avnadmin:password@mysql-gallery-art.aivencloud.com:12345/defaultdb?ssl={"rejectUnauthorized":true}
# Local Dev:     DATABASE_URL=mysql://root:@127.0.0.1:3306/art_gallery_db
DATABASE_URL=mysql://root:@127.0.0.1:3306/art_gallery_db

# Alternative individual MySQL credentials (if DATABASE_URL is not used):
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=art_gallery_db
# MYSQL_SSL=false

# ----------------------------------------------------------
# 2. AUTOMATED TRANSACTIONAL EMAILS (Resend or SendGrid)
# ----------------------------------------------------------
# Get a free API key at https://resend.com (3,000 emails/month free, 0 setup hassle).
# When set, the website automatically sends:
#  1. Instant confirmation to the customer's email with the inquired artwork details.
#  2. Direct inquiry notification alert to your curator admin email.
# Option A: Resend API Key (Get at https://resend.com)
# Note: With onboarding@resend.dev, Resend restricts delivery to your registered Resend email.
# To send to ANY customer email worldwide, verify your domain at https://resend.com/domains
RESEND_API_KEY=re_your_resend_api_key_here

# Sender email (defaults to onboarding@resend.dev, or your verified domain e.g. inquiries@55smartcreatives.com)
EMAIL_FROM=55 smartCREATIVES <onboarding@resend.dev>

# Option B: Free Gmail SMTP (Delivers to ANY email in the world with ZERO domain setup)
# Generate a free 16-character App Password at: https://myaccount.google.com/apppasswords
# GMAIL_USER=edsonndyanabo84@gmail.com
# GMAIL_APP_PASSWORD=your_16_char_app_password

# Curator Admin Notification Recipient:
ADMIN_EMAIL=edsonndyanabo84@gmail.com

# ----------------------------------------------------------
# 3. SITE URL / CUSTOM DOMAIN CONFIGURATION
# ----------------------------------------------------------
# Base public URL of your gallery (used for email links to artworks & admin dashboard).
# In production on Vercel, set this to your custom domain or Vercel production URL.
# e.g., https://55smartcreatives.com or https://55smartcreatives.vercel.app
SITE_URL=http://localhost:3000
